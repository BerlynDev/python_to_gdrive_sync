# =========================================================
# Google Drive / Google API secrets — NEVER commit these
# =========================================================
# Put all credential/token files in credentials/ — everything inside is
# ignored; only the .gitkeep placeholder is tracked so the folder exists.
credentials/*
!credentials/.gitkeep

# Fallback patterns in case a secret ends up elsewhere
credential*.json
credentials*.json
client_secret*.json
token.json
token.pickle
*.pickle
service_account*.json
service-account*.json
*-sa.json
# PyDrive / PyDrive2
settings.yaml
mycreds.txt
saved_credentials.json
# rclone-style configs
*.conf

# Environment variables / local config
.env
.env.*
!.env.example
config.local.*
*.local.json

# =========================================================
# Sync state, caches, logs and local data
# =========================================================
*.db
*.sqlite
*.sqlite3
sync_state*.json
.sync/
.cache/
logs/
*.log
downloads/
sync_folder/
tmp/
temp/

# =========================================================
# Python
# =========================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
*.egg
wheels/
pip-wheel-metadata/
*.spec

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Testing / coverage / type checking / linting
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.pytype/
.dmypy.json

# Jupyter
.ipynb_checkpoints/

# =========================================================
# Editors / OS
# =========================================================
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
